При использование "стандартных" селектов в pgbench самый продуктивный результат показал режим transaction
Но это в данном случае, по факту же все зависит от "логики" разработки приложений, использующих postgres.
Как пример, можно использовать pool_mode=session и "отстреливать" неактивные сессии, а на их место "ставить" активные.
Но посторюсь, все зависит от логики приложений. 

postgres@ivan-psql-3:~$ pgbench -i shulcev -p 6432
postgres@ivan-psql-3:~$ cat /etc/pgbouncer/pgbouncer.ini 
[databases]
ivan = host=127.0.0.1 port=5432 dbname=ivan pool_size=20 pool_mode=session

shulcev = host=127.0.0.1 port=5432 dbname=ivan pool_size=20 pool_mode=session

* = host=127.0.0.1 port=5432

[pgbouncer]
...
root@ivan-psql-3:~# systemctl reload pgbouncer.service

postgres@ivan-psql-3:~$ pgbench  shulcev -p 6432 -S
